---
layout: null
permalink: assets/map/properties.json
sitemap:
  exclude: 'yes'
---
{%- comment -%}
  GeoJSON for /map/: every Property with valid coordinates.
  Skips coordinates outside the western hemisphere (data typos), and places outside the basemap extract
  (map_bounds in _config.yml: west, south, east, north).
  #ThenAndNow is not a map category: it is left out of "cats", and properties with no other category are skipped.
  "category" is the first #Category listed; the map colors markers by it.
  "cats" lists every #Category as |#A|#B| so the map's checkboxes can match any of them.
  (MapLibre flattens arrays in GeoJSON properties, so a delimited string stands in for a list.)
{%- endcomment -%}
{%- assign items = site.property | sort: "title" -%}
{%- assign bounds = site.map_bounds -%}
{%- assign first = true -%}
{"type":"FeatureCollection","features":[
{%- for item in items -%}
  {%- if item.title == nil or item.latitude == nil or item.latitude == '' or item.longitude == nil or item.longitude == '' -%}{%- continue -%}{%- endif -%}
  {%- assign lat = item.latitude | plus: 0 -%}
  {%- assign lng = item.longitude | plus: 0 -%}
  {%- if lng >= 0 or lat <= 0 -%}{%- continue -%}{%- endif -%}
  {%- if bounds -%}
    {%- if lng < bounds[0] or lat < bounds[1] or lng > bounds[2] or lat > bounds[3] -%}{%- continue -%}{%- endif -%}
  {%- endif -%}
  {%- assign category = '' -%}
  {%- assign cats = '|' -%}
  {%- for c in item.categories -%}
    {%- assign c1 = c | slice: 0 -%}
    {%- if c1 == '#' and c != '#ThenAndNow' -%}
      {%- if category == '' -%}{%- assign category = c -%}{%- endif -%}
      {%- assign cats = cats | append: c | append: '|' -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if category == '' -%}{%- continue -%}{%- endif -%}
  {%- assign img = nil -%}
  {%- if item.thumbnail -%}{%- assign img = item.thumbnail -%}{%- else -%}{%- assign img = item.images.first.url -%}{%- endif -%}
  {%- if img -%}{%- assign img = site.propimg_path | append: 'r/480/' | append: img -%}{%- endif -%}
  {%- unless first -%},{%- endunless -%}{%- assign first = false %}
{"type":"Feature","geometry":{"type":"Point","coordinates":[{{ item.longitude | strip }},{{ item.latitude | strip }}]},"properties":{"title":{{ item.title | jsonify }},"url":{{ item.url | jsonify }},"category":{{ category | jsonify }},"cats":{{ cats | jsonify }},"address":{{ item.address | default: '' | jsonify }}{% if img %},"img":{{ img | jsonify }}{% endif %}}}
{%- endfor %}
]}
